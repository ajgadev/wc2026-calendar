# football-data.org — free signup at https://www.football-data.org/client/register
# World Cup data is in the free tier forever (10 req/min; the /api/live cache keeps us at ≤1/min).
FOOTBALL_DATA_TOKEN=

# YouTube Data API v3 — optional. Free Google Cloud key with the YouTube Data API enabled.
# Without it, highlights run in RSS-only mode (recent uploads only, no durable archive).
YOUTUBE_API_KEY=

# Neither secret may ever appear in client code: islands only call /api/* endpoints.
# On Cloudflare Pages set both as encrypted environment variables.
