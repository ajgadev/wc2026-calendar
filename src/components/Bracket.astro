---
/**
 * Knockout wallchart in two layouts (designer's update):
 *  - Tree: symmetric two-wing chart with CSS connector lines converging
 *    on a glowing Final in the centre, third place beneath. Default on
 *    desktop.
 *  - Radial: interactive circular bracket — R32 on the outer ring, lines
 *    converging inward through R16/QF/SF to the Final + trophy at the
 *    centre. Default on phones. Follow the line inward; tap any node for
 *    match details.
 * Both derive from the schedule's W{n} references (lib/bracket), so
 * resolved teams fill in on rebuild with zero code changes.
 */
import { MATCHES } from '../data/schedule';
import { TEAMS } from '../data/teams';
import { TEAM_COLORS } from '../data/teamColors';
import { buildBracketTree, shortPlaceholder } from '../lib/bracket';
import { dayLabel } from '../lib/time';
import { stadiumOf, flagSrc, hostClass, matchDayKey, stateOf, venueChip, searchText } from '../lib/view';
import { decide, penCell } from '../lib/result';
import type { Match } from '../lib/types';

const tree = buildBracketTree(MATCHES);
const thirdPlace = tree.thirdPlace;

function slot(m: Match, side: 'a' | 'b') {
  const code = side === 'a' ? m.a : m.b;
  const ph = side === 'a' ? m.pa : m.pb;
  const [fa, fb] = m.ft ?? [-1, -1];
  // decide() resolves the winner from the pen tally too, so a level full
  // time settled on penalties still highlights the side that advanced
  const d = m.ft ? decide(m.ft, m.pens ?? null) : null;
  const won = d ? d.win === side : false;
  const lost = d ? d.win !== null && d.win !== side : false;
  const num = m.ft ? (side === 'a' ? fa : fb) : null;
  const pen = m.pens ? (side === 'a' ? m.pens[0] : m.pens[1]) : null;
  // score cell carries the shootout tally in parens — "1 (4)"
  return { side, code, label: code ? TEAMS[code].name : shortPlaceholder(ph ?? ''), score: num, scoreText: num === null ? '' : penCell(num, pen), won, lost };
}

// ---- tree column layout ----
const CW = 156; // match column width
const FW = 200; // final column width
const CONN = 30; // connector column width
const H = 768; // fixed tree body height (keeps cards aligned to connectors)

type TreeCol =
  | { kind: 'm'; w: number; head: string; matches: Match[] }
  | { kind: 'c'; w: number; count: number; side: 'left' | 'right'; straight?: boolean }
  | { kind: 'final'; w: number };

const treeCols: TreeCol[] = [
  { kind: 'm', w: CW, head: 'R32', matches: tree.left.R32 },
  { kind: 'c', w: CONN, count: 4, side: 'left' },
  { kind: 'm', w: CW, head: 'R16', matches: tree.left.R16 },
  { kind: 'c', w: CONN, count: 2, side: 'left' },
  { kind: 'm', w: CW, head: 'QF', matches: tree.left.QF },
  { kind: 'c', w: CONN, count: 1, side: 'left' },
  { kind: 'm', w: CW, head: 'SF', matches: tree.left.SF },
  { kind: 'c', w: CONN, count: 1, side: 'left', straight: true },
  { kind: 'final', w: FW },
  { kind: 'c', w: CONN, count: 1, side: 'right', straight: true },
  { kind: 'm', w: CW, head: 'SF', matches: tree.right.SF },
  { kind: 'c', w: CONN, count: 1, side: 'right' },
  { kind: 'm', w: CW, head: 'QF', matches: tree.right.QF },
  { kind: 'c', w: CONN, count: 2, side: 'right' },
  { kind: 'm', w: CW, head: 'R16', matches: tree.right.R16 },
  { kind: 'c', w: CONN, count: 4, side: 'right' },
  { kind: 'm', w: CW, head: 'R32', matches: tree.right.R32 },
];

/** Absolute-positioned border lines for one connector unit. */
function connectorUnit(side: 'left' | 'right', straight?: boolean): string[] {
  const border = '1px solid var(--color-border)';
  if (straight) return [`top:50%;left:0;right:0;border-top:${border}`];
  const left = side === 'left';
  const feed = left ? 'left:0' : 'right:0';
  const out = left ? 'right:0' : 'left:0';
  const vx = left ? 'left:50%' : 'right:50%';
  return [
    `top:25%;width:50%;border-top:${border};${feed}`,
    `top:75%;width:50%;border-top:${border};${feed}`,
    `top:25%;height:50%;border-left:${border};${vx}`,
    `top:50%;width:50%;border-top:${border};${out}`,
  ];
}

const treeCardCls = 'focus-ring live-border tinted box-border flex w-full flex-col gap-[5px] rounded-[9px] border border-border px-[9px] py-2 hover:border-border-strong';

// ---- radial layout (full-circle wallchart) ----
// The 16 Round-of-32 matches tile ONE evenly-spaced ring — the right half
// of the draw fills the east arc, the left half the west — so the ring is
// continuous with no empty poles. Each parent match sits at the midpoint
// of its two feeders' angles, so R16 → QF → SF land at the centre of their
// arc and the Final lands dead centre, feeders arriving from opposite
// sides. Every match renders as its two circular team badges; winners
// reappear one ring inward, exactly like a printed wallchart bent into a
// circle.
type Ring = 'R32' | 'R16' | 'QF' | 'SF';
const RING_R: Record<Ring, number> = { R32: 0.43, R16: 0.325, QF: 0.22, SF: 0.118 };
const rad = (deg: number) => (deg * Math.PI) / 180;

// Tangent angle for a node's flag pair: perpendicular to the radius,
// normalised to (−90°, 90°] so the two flags always follow the circle's
// circumference (horizontal at the poles, vertical at east/west) without
// ever flipping upside-down.
const normDeg = (a: number) => ((((a + 90) % 180) + 180) % 180) - 90;
const rotOf = (deg: number) => normDeg(deg + 90);
// Winner colour / side for a decided match (else '' / null).
const decidedSide = (m: Match | undefined): 'a' | 'b' | null =>
  m && m.ft ? decide(m.ft, m.pens ?? null).win : null;
const colorOf = (m: Match | undefined): string => {
  const w = decidedSide(m);
  if (!w || !m) return '';
  const code = w === 'a' ? m.a : m.b;
  return code ? (TEAM_COLORS[code] ?? 'var(--color-win)') : 'var(--color-win)';
};

// One global angle per match. R32 is a single ring split into two
// contiguous halves; the right half is centred on 0° (east), the left on
// 180° (west), so the two finalists converge on the centre head-on.
const rAng = new Map<number, number>();
{
  const order = [...tree.right.R32, ...tree.left.R32];
  const N = order.length || 1;
  const STEP = 360 / N;
  const START = -((N / 2 - 1) / 2) * STEP; // right half's centre → 0°
  order.forEach((m, i) => rAng.set(m.n, START + i * STEP));
  // feeders within a half are always adjacent, so a plain mean is the arc
  // midpoint (no circular-wrap needed); a lost edge degrades to one feeder.
  const avg = (a?: Match, b?: Match): number | null => {
    const xs = [a, b].map((m) => (m ? rAng.get(m.n) : undefined)).filter((v): v is number => v != null);
    return xs.length ? xs.reduce((s, v) => s + v, 0) / xs.length : null;
  };
  const set = (m: Match, v: number | null) => { if (v != null) rAng.set(m.n, v); };
  for (const half of [tree.right, tree.left]) {
    half.R16.forEach((m, i) => set(m, avg(half.R32[2 * i], half.R32[2 * i + 1])));
    half.QF.forEach((m, i) => set(m, avg(half.R16[2 * i], half.R16[2 * i + 1])));
    half.SF.forEach((m, i) => set(m, avg(half.QF[2 * i], half.QF[2 * i + 1])));
  }
}

interface RNode { m: Match; ring: Ring; deg: number; x: number; y: number; }
const rNodes: RNode[] = [];
const rPos = new Map<number, { x: number; y: number }>();
const CENTER = { x: 0.5, y: 0.5 };

const place = (list: Match[], ring: Ring) => {
  for (const m of list) {
    const deg = rAng.get(m.n);
    if (deg == null) continue; // unplaceable (lost edge) — skip rather than NaN
    const p = { x: 0.5 + RING_R[ring] * Math.cos(rad(deg)), y: 0.5 + RING_R[ring] * Math.sin(rad(deg)) };
    rNodes.push({ m, ring, deg, x: p.x, y: p.y });
    rPos.set(m.n, p);
  }
};
for (const half of [tree.right, tree.left]) {
  place(half.R32, 'R32'); place(half.R16, 'R16'); place(half.QF, 'QF'); place(half.SF, 'SF');
}
if (tree.final) rPos.set(tree.final.n, CENTER);

// Position of one flag within a node — offset from the node centre along
// the tangent (slot a on the − side, b on the + side), matching how the two
// badges are laid out. Used as the connector's precise endpoint so a
// coloured line ends exactly on its team's badge, not the node centre.
const HALF_SEP = 0.02; // ≈ half a badge, as a fraction of the stage
const flagAt = (n: number, side: 'a' | 'b'): { x: number; y: number } | null => {
  const c = rPos.get(n);
  if (!c) return null;
  const deg = rAng.get(n);
  if (deg == null) return c;
  const r = rad(rotOf(deg));
  const s = side === 'a' ? -1 : 1;
  return { x: c.x + s * HALF_SEP * Math.cos(r), y: c.y + s * HALF_SEP * Math.sin(r) };
};

// Connectors: right-angle "elbows", not curves. Each child feeds a fixed
// parent slot (R16[i] ← R32[2i]=a / R32[2i+1]=b, etc.), so the line ends on
// that slot's badge — where the child's winner lands — and is tinted with
// that winner's country colour. Undecided → grey, drawn from centre.
//
// The elbow is drawn in polar space so it reads like a wallchart bent into a
// circle: a straight RADIAL leg inward from the child (toward the centre)
// down to the parent's ring, then a straight TANGENTIAL leg across to the
// parent slot — a clean L with a single 90° corner, no bézier bow. The
// corner is nudged short of a hard miter with a tiny rounded joint.
const rEdges: { d: string; color: string; child: number }[] = [];
const CORNER = 0.012; // radius of the rounded elbow joint (fraction of stage)
const polar = (p: { x: number; y: number }) => ({
  r: Math.hypot(p.x - CENTER.x, p.y - CENTER.y),
  a: Math.atan2(p.y - CENTER.y, p.x - CENTER.x),
});
const atPolar = (r: number, a: number) => ({ x: CENTER.x + r * Math.cos(a), y: CENTER.y + r * Math.sin(a) });
const P = (p: { x: number; y: number }) => `${(p.x * 1000).toFixed(1)} ${(p.y * 1000).toFixed(1)}`;
const pushEdge = (
  start: { x: number; y: number } | null,
  end: { x: number; y: number } | null,
  color: string,
  child: number,
) => {
  if (!start || !end) return;
  const s = polar(start);
  const e = polar(end);
  // Corner sits at the parent's radius, on the child's ray → radial leg first.
  const corner = atPolar(e.r, s.a);
  // Straight-line fallback when the two share a ray (e.g. SF → centre Final).
  if (Math.abs(s.a - e.a) < 1e-3 || e.r < 1e-4) {
    rEdges.push({ d: `M${P(start)} L${P(end)}`, color, child });
    return;
  }
  // Pull the two legs back from the corner and bridge them with a short
  // quadratic so the 90° turn is crisp but not a razor point.
  const cIn = atPolar(e.r + CORNER, s.a); // on the radial leg, just before the corner
  const legLen = Math.hypot(end.x - corner.x, end.y - corner.y) || 1;
  const step = Math.min(CORNER, legLen) / legLen; // step toward end, clamped
  const cOut = { x: corner.x + (end.x - corner.x) * step, y: corner.y + (end.y - corner.y) * step };
  rEdges.push({
    d: `M${P(start)} L${P(cIn)} Q${P(corner)} ${P(cOut)} L${P(end)}`,
    color,
    child,
  });
};
const linkFlag = (child: Match | undefined, parentN: number, slot: 'a' | 'b') => {
  if (!child) return;
  const win = decidedSide(child);
  // decided: winner-badge (child) → the slot it feeds (parent); else centre → slot
  const start = win ? flagAt(child.n, win) : rPos.get(child.n) ?? null;
  const end = parentN === (tree.final?.n ?? -1) ? CENTER : flagAt(parentN, slot);
  pushEdge(start, end, colorOf(child), child.n);
};
for (const half of [tree.right, tree.left]) {
  half.R16.forEach((m, i) => { linkFlag(half.R32[2 * i], m.n, 'a'); linkFlag(half.R32[2 * i + 1], m.n, 'b'); });
  half.QF.forEach((m, i) => { linkFlag(half.R16[2 * i], m.n, 'a'); linkFlag(half.R16[2 * i + 1], m.n, 'b'); });
  half.SF.forEach((m, i) => { linkFlag(half.QF[2 * i], m.n, 'a'); linkFlag(half.QF[2 * i + 1], m.n, 'b'); });
  if (tree.final) linkFlag(half.SF[0], tree.final.n, 'a');
}

const rFlag = 'h-[22px] w-[22px] shrink-0 rounded-full object-cover';
const rFlagPh = 'box-border h-[22px] w-[22px] shrink-0 rounded-full border border-dashed border-border-strong';
const pct = (v: number) => `${(v * 100).toFixed(2)}%`;
---

<div class="pt-4" data-brmode="auto" data-bracket-root>
  <!-- toggle + caption -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-0.5 pb-3.5">
    <div role="group" aria-label="Bracket layout" class="inline-flex gap-0.5 rounded-[9px] border border-border bg-surface p-[3px]">
      {(['tree', 'radial'] as const).map((mode) => (
        <button
          type="button"
          data-brset={mode}
          class="focus-ring-surface min-h-[38px] rounded-md px-3.5 py-1.5 t-meta font-semibold capitalize text-text-3 aria-[current]:bg-raised aria-[current]:text-text"
        >
          {mode}
        </button>
      ))}
    </div>
    <span class="t-micro min-w-0 flex-1 text-text-dim">Pairings fill in as groups conclude — placeholders show who feeds each slot. Single elimination · Jun 28 – Jul 19.</span>
  </div>

  <!-- ============ TREE ============ -->
  <!-- The wallchart is laid out at a fixed natural width; a scaler shrinks
       the whole thing to fit the column so the full bracket is visible with
       no horizontal scroll (falls back to scroll if scaling isn't wired). -->
  <div class="brview-tree pb-2.5" data-tree-scaler>
    <div class="flex flex-col gap-1.5" data-tree-inner style="width:max-content">

      <!-- header labels aligned to columns -->
      <div class="flex items-end">
        {treeCols.map((col) => (
          <div class="disp text-center t-micro font-black tracking-[0.08em] text-text-3" style={`width:${col.w}px;flex:0 0 ${col.w}px`}>
            {col.kind === 'm' ? col.head : ''}
          </div>
        ))}
      </div>
      <!-- body -->
      <div class="flex items-stretch">
        {treeCols.map((col) => {
          if (col.kind === 'c') {
            return (
              <div class="flex shrink-0 flex-col" style={`width:${col.w}px;height:${H}px`}>
                {Array.from({ length: col.count }).map(() => (
                  <div class="relative" style="flex:1 1 0">
                    {connectorUnit(col.side, col.straight).map((s) => (
                      <span class="absolute" style={s}></span>
                    ))}
                  </div>
                ))}
              </div>
            );
          }
          if (col.kind === 'final') {
            const f = tree.final;
            const t = tree.thirdPlace;
            return (
              <div class="flex shrink-0 flex-col items-center justify-center gap-3.5" style={`width:${col.w}px;height:${H}px`}>
                {f && (
                  <>
                    <div class="flex flex-col items-center gap-[3px]">
                      <span class="disp text-[11px] font-black tracking-[0.18em] text-live">★ FINAL</span>
                      <span class="text-[9.5px] tracking-[0.04em] text-text-dim"><span data-kick-date={f.utc}>{dayLabel(matchDayKey(f))} · {stadiumOf(f).cityShort}</span></span>
                    </div>
                    <button
                      type="button"
                      data-match data-n={f.n} data-open-match={f.n} data-state={stateOf(f)} data-stage="F" data-flagsize="md"
                      data-country={stadiumOf(f).country.toLowerCase()} data-teams={[f.a, f.b].filter(Boolean).join(' ')} data-search={searchText(f)}
                      class:list={['focus-ring live-border tinted box-border flex w-full flex-col gap-[7px] rounded-xl border px-3 py-3', hostClass(f)]}
                      style="border-color:color-mix(in srgb, var(--color-live) 55%, transparent);box-shadow:0 0 22px color-mix(in srgb, var(--color-live) 12%, transparent)"
                    >
                      <span class="flex items-center justify-between gap-1.5">
                        <span class="font-mono text-[9.5px] text-text-dim">M{f.n}</span>
                        <span class:list={['host-chip rounded-(--radius-chip) px-[5px] py-px text-[9.5px] font-semibold whitespace-nowrap', hostClass(f)]}>{venueChip(f)}</span>
                      </span>
                      {[slot(f, 'a'), slot(f, 'b')].map((s) => (
                        <span data-slot={s.side} data-result={s.won ? 'won' : s.lost ? 'lost' : ''} class="flex min-w-0 items-center gap-[7px]">
                          {s.code
                            ? <img data-flag src={flagSrc(s.code)} alt="" width="18" height="13" loading="lazy" class="h-[13px] w-[18px] shrink-0 rounded-[2px] object-cover" />
                            : <span data-flag class="box-border h-[13px] w-[18px] shrink-0 rounded-[2px] border border-dashed border-border-strong"></span>}
                          <span data-slot-label class="t-meta truncate font-bold text-text">{s.label}</span>
                          <span data-slot-score class="disp t-meta ml-auto font-black tnum text-text">{s.scoreText}</span>
                        </span>
                      ))}
                    </button>
                  </>
                )}
                {t && (
                  <button
                    type="button"
                    data-match data-n={t.n} data-open-match={t.n} data-state={stateOf(t)} data-stage="3RD"
                    data-country={stadiumOf(t).country.toLowerCase()} data-teams={[t.a, t.b].filter(Boolean).join(' ')} data-search={searchText(t)}
                    class="focus-ring box-border flex w-full flex-col gap-1 rounded-[9px] border border-dashed border-border-strong bg-surface px-2.5 py-2 hover:border-text-3"
                  >
                    <span class="text-[9px] font-bold tracking-[0.12em] text-text-3">THIRD PLACE · M{t.n}</span>
                    <span class="t-micro truncate text-text-3">{slot(t, 'a').label} · {slot(t, 'b').label}</span>
                  </button>
                )}
              </div>
            );
          }
          // match column
          return (
            <div class="flex shrink-0 flex-col" style={`width:${col.w}px;height:${H}px`}>
              {col.matches.map((m) => {
                const a = slot(m, 'a');
                const b = slot(m, 'b');
                return (
                  <div class="flex items-center px-[5px]" style="flex:1 1 0">
                    <button
                      type="button"
                      data-match data-n={m.n} data-open-match={m.n} data-state={stateOf(m)} data-stage={m.stage} data-flagsize="sm"
                      data-country={stadiumOf(m).country.toLowerCase()} data-teams={[m.a, m.b].filter(Boolean).join(' ')} data-search={searchText(m)}
                      title={m.a && m.b ? `${TEAMS[m.a].name} vs ${TEAMS[m.b].name}` : `${m.pa} vs ${m.pb}`}
                      class:list={[treeCardCls, hostClass(m)]}
                    >
                      <span class="flex items-center justify-between gap-1.5">
                        <span class="font-mono text-[9px] text-text-dim">M{m.n}</span>
                        <span class:list={['host-chip rounded-(--radius-chip) px-1 py-px text-[9px] font-semibold whitespace-nowrap', hostClass(m)]}>{venueChip(m)}</span>
                      </span>
                      {[{ s: a, key: 'home' }, { s: b, key: 'away' }].map(({ s, key }) => (
                        <span data-slot={s.side} data-result={s.won ? 'won' : s.lost ? 'lost' : ''} class="flex min-w-0 items-center gap-1.5">
                          {s.code
                            ? <img data-flag src={flagSrc(s.code)} alt="" width="16" height="12" loading="lazy" class="h-3 w-4 shrink-0 rounded-[2px] object-cover" />
                            : <span data-flag class="box-border h-3 w-4 shrink-0 rounded-[2px] border border-dashed border-border-strong"></span>}
                          <span data-slot-label class="t-micro truncate whitespace-nowrap font-bold text-text-2">{s.label}</span>
                          <span data-slot-score class="w-score disp ml-auto t-micro font-black tnum text-text-2" {...{ [`data-score-${key}`]: true }}>{s.scoreText}</span>
                        </span>
                      ))}
                    </button>
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- ============ RADIAL ============ -->
  <div class="brview-radial">
    <div class="radial-stage" data-radial>
      <!-- connector elbows, child → parent, converging on the centre -->
      <svg viewBox="0 0 1000 1000" class="pointer-events-none absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        {rEdges.filter((e) => !e.color).map((e) => <path data-radial-edge={e.child} d={e.d} fill="none" stroke="var(--color-border)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />)}
        {rEdges.filter((e) => e.color).map((e) => <path data-radial-edge={e.child} d={e.d} fill="none" stroke={e.color} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.92" />)}
      </svg>

      <!-- centre: trophy + the Final -->
      {tree.final && (() => {
        const f = tree.final;
        return (
          <div class="radial-final" style={`left:${pct(0.5)};top:${pct(0.5)}`}>
            <span class="radial-trophy" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" />
                <path d="M7 6H4.5v.8A3 3 0 0 0 7 10M17 6h2.5v.8A3 3 0 0 1 17 10" />
                <path d="M12 13v3.5M9.5 20h5M10.5 16.5h3" />
              </svg>
            </span>
            <span class="disp text-[10px] font-black tracking-[0.2em] text-live">FINAL</span>
            <button
              type="button"
              data-match data-n={f.n} data-open-match={f.n} data-state={stateOf(f)} data-stage="F" data-flagsize="circle"
              data-country={stadiumOf(f).country.toLowerCase()} data-teams={[f.a, f.b].filter(Boolean).join(' ')} data-search={searchText(f)}
              title={f.a && f.b ? `${TEAMS[f.a].name} vs ${TEAMS[f.b].name}` : `${f.pa} vs ${f.pb}`}
              aria-label={f.a && f.b ? `Final: ${TEAMS[f.a].name} vs ${TEAMS[f.b].name}` : `Final: ${f.pa} vs ${f.pb}`}
              class:list={['radial-node radial-node--final focus-ring live-border', hostClass(f)]}
            >
              {[slot(f, 'a'), slot(f, 'b')].map((s) => (
                <span data-slot={s.side} data-result={s.won ? 'won' : s.lost ? 'lost' : ''} class="rn-row">
                  {s.code
                    ? <img data-flag src={flagSrc(s.code)} alt="" width="22" height="22" loading="lazy" class={rFlag} />
                    : <span data-flag class={rFlagPh}></span>}
                  <span data-slot-score class="rn-score">{s.scoreText}</span>
                </span>
              ))}
            </button>
            <span class="text-[8.5px] tracking-[0.04em] whitespace-nowrap text-text-dim"><span data-kick-date={f.utc}>{dayLabel(matchDayKey(f))} · {stadiumOf(f).cityShort}</span></span>
          </div>
        );
      })()}

      <!-- match nodes on the rings: two circular team badges, winner ringed.
           The pair rotates to lie along the circle's tangent (--rot); the
           badges counter-rotate so flags stay upright. -->
      {rNodes.map(({ m, ring, x, y, deg }) => {
        const a = slot(m, 'a');
        const b = slot(m, 'b');
        return (
          <button
            type="button"
            data-match data-n={m.n} data-open-match={m.n} data-state={stateOf(m)} data-stage={m.stage} data-flagsize="circle"
            data-country={stadiumOf(m).country.toLowerCase()} data-teams={[m.a, m.b].filter(Boolean).join(' ')} data-search={searchText(m)}
            title={m.a && m.b ? `${TEAMS[m.a].name} vs ${TEAMS[m.b].name}` : `${m.pa} vs ${m.pb}`}
            aria-label={m.a && m.b ? `${TEAMS[m.a].name} vs ${TEAMS[m.b].name}` : `${m.pa} vs ${m.pb}`}
            class:list={[`rnode rnode--${ring.toLowerCase()} focus-ring live-border`, hostClass(m)]}
            style={`left:${pct(x)};top:${pct(y)};--rot:${rotOf(deg).toFixed(1)}deg`}
          >
            {[a, b].map((s) => (
              <span data-slot={s.side} data-result={s.won ? 'won' : s.lost ? 'lost' : ''} class="rnode__slot">
                {s.code
                  ? <img data-flag src={flagSrc(s.code)} alt="" width="22" height="22" loading="lazy" class={rFlag} />
                  : <span data-flag class={rFlagPh}></span>}
              </span>
            ))}
          </button>
        );
      })}
    </div>

    <p class="mt-1 text-center t-micro text-text-dim">Follow the line inward. Tap any node for match details.</p>

    {thirdPlace && (
      <div class="mt-2.5 flex justify-center">
        <button
          type="button"
          data-match data-n={thirdPlace.n} data-open-match={thirdPlace.n} data-state={stateOf(thirdPlace)} data-stage="3RD"
          data-country={stadiumOf(thirdPlace).country.toLowerCase()} data-teams={[thirdPlace.a, thirdPlace.b].filter(Boolean).join(' ')} data-search={searchText(thirdPlace)}
          class="focus-ring box-border inline-flex items-center gap-2 rounded-(--radius-pill) border border-dashed border-border-strong bg-surface px-3.5 py-2 hover:border-text-3"
        >
          <span class="text-[9px] font-bold tracking-[0.12em] text-text-3">3RD PLACE · M{thirdPlace.n}</span>
          <span class="t-micro truncate text-text-2">{slot(thirdPlace, 'a').label} · {slot(thirdPlace, 'b').label}</span>
        </button>
      </div>
    )}
  </div>
</div>

<script>
  // ---- Tree/Radial toggle (persisted) ----
  const root = document.querySelector<HTMLElement>('[data-bracket-root]');
  if (root) {
    const segs = root.querySelectorAll<HTMLElement>('[data-brset]');

    // Scale the fixed-width wallchart to show the whole thing with no
    // horizontal scroll, using the full viewport width (the chart breaks
    // out of the max-width column) so wide screens get a bigger bracket.
    // `zoom` (not `transform`) so the layout box scales too — otherwise the
    // unscaled height would leak as vertical overflow.
    const scaler = root.querySelector<HTMLElement>('[data-tree-scaler]');
    const inner = root.querySelector<HTMLElement>('[data-tree-inner]');
    const fitTree = () => {
      if (!scaler || !inner) return;
      if (root.dataset.brmode !== 'tree') {
        scaler.style.width = scaler.style.marginLeft = '';
        inner.style.zoom = '';
        return;
      }
      // break out of the padded column to span (nearly) the whole viewport
      inner.style.zoom = '1'; // measure natural width first
      const gap = 16;
      const docW = document.documentElement.clientWidth;
      const rootLeft = root.getBoundingClientRect().left;
      const avail = docW - gap * 2;
      scaler.style.width = `${avail}px`;
      scaler.style.marginLeft = `${gap - rootLeft}px`;
      const natural = inner.scrollWidth;
      // never upscale past 1:1 — keeps the cards crisp and readable
      inner.style.zoom = String(natural > 0 ? Math.min(1, avail / natural) : 1);
    };

    const apply = (mode: string) => {
      root.dataset.brmode = mode;
      segs.forEach((s) => {
        if (s.dataset.brset === mode) s.setAttribute('aria-current', 'true');
        else s.removeAttribute('aria-current');
      });
      fitTree();
    };
    window.addEventListener('resize', fitTree);
    let saved: string | null = null;
    try { saved = localStorage.getItem('wc26-brmode'); } catch { /* ignore */ }
    if (saved === 'columns') saved = 'radial'; // migrate the retired layout
    // radial is the default everywhere (fits without horizontal scroll)
    apply(new URLSearchParams(location.search).get('brmode') ?? saved ?? 'radial');
    segs.forEach((s) => s.addEventListener('click', () => {
      const mode = s.dataset.brset!;
      apply(mode);
      try { localStorage.setItem('wc26-brmode', mode); } catch { /* ignore */ }
    }));
  }
</script>
